{
  "$defs": {
    "AuthorityScope": {
      "additionalProperties": false,
      "description": "What the assistant may discuss without the owner. Everything else escalates.",
      "properties": {
        "may_ask_about": {
          "items": {
            "type": "string"
          },
          "title": "May Ask About",
          "type": "array"
        },
        "may_not": {
          "items": {
            "type": "string"
          },
          "title": "May Not",
          "type": "array"
        }
      },
      "title": "AuthorityScope",
      "type": "object"
    },
    "CallQuestion": {
      "additionalProperties": false,
      "description": "One question the assistant may ask, grounded in an UNKNOWN / MAY_REQUIRE_WORK assessment.",
      "properties": {
        "claim_type": {
          "description": "Evidence observation_type an answer would produce, e.g. 'tenant_subpanel_amps'",
          "title": "Claim Type",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Id"
        }
      },
      "required": [
        "question",
        "claim_type"
      ],
      "title": "CallQuestion",
      "type": "object"
    },
    "CallState": {
      "enum": [
        "CREATED",
        "DIALING",
        "INTRO",
        "ACTIVE",
        "HANDOFF_PENDING",
        "OWNER_JOINING",
        "HUMAN_JOINED",
        "AI_RESUMED",
        "COMPLETED",
        "FAILED",
        "DECLINED",
        "CANCELLED"
      ],
      "title": "CallState",
      "type": "string"
    },
    "ParticipantState": {
      "additionalProperties": false,
      "properties": {
        "leg_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leg Id"
        },
        "role": {
          "description": "'assistant' | 'counterparty' | 'owner'",
          "title": "Role",
          "type": "string"
        },
        "state": {
          "description": "'dialing' | 'joined' | 'left' | 'failed'",
          "title": "State",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "role",
        "state"
      ],
      "title": "ParticipantState",
      "type": "object"
    },
    "StructuredFinding": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "claim_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'electrical_service_amps'",
          "title": "Claim Type"
        },
        "classification": {
          "default": "OWNER_REPORTED",
          "title": "Classification",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "transcript_offset_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Offset S"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "question"
      ],
      "title": "StructuredFinding",
      "type": "object"
    },
    "TranscriptTurn": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "speaker": {
          "description": "'assistant' | 'counterparty' | 'owner' | 'system'",
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "text"
      ],
      "title": "TranscriptTurn",
      "type": "object"
    }
  },
  "$id": "https://second-site.dev/contracts/1.0/CallSession.json",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "authority_scope": {
      "$ref": "#/$defs/AuthorityScope"
    },
    "automation_disclosure": {
      "default": "This call is being handled by an automated assistant on the owner's behalf.",
      "description": "Disclosure played/stated per applicable law and provider rules.",
      "title": "Automation Disclosure",
      "type": "string"
    },
    "call_id": {
      "format": "uuid",
      "title": "Call Id",
      "type": "string"
    },
    "communication_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Communication Id"
    },
    "conference_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conference Id"
    },
    "deferred_questions": {
      "description": "Sensitive questions the assistant declined to answer for the owner.",
      "items": {
        "type": "string"
      },
      "title": "Deferred Questions",
      "type": "array"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/StructuredFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "handoff_request_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Handoff Request Id"
    },
    "intro_recording_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Owner's genuine recorded intro (object storage key). Never synthesized.",
      "title": "Intro Recording Reference"
    },
    "outcome_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome Summary"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "participant_states": {
      "items": {
        "$ref": "#/$defs/ParticipantState"
      },
      "title": "Participant States",
      "type": "array"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "property_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property Id"
    },
    "provider_call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Call Id"
    },
    "question_index": {
      "default": 0,
      "title": "Question Index",
      "type": "integer"
    },
    "recipient": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "{'role':'broker','name':'...','phone':'+1...'}",
      "title": "Recipient",
      "type": "object"
    },
    "script": {
      "items": {
        "$ref": "#/$defs/CallQuestion"
      },
      "title": "Script",
      "type": "array"
    },
    "simulated": {
      "default": false,
      "description": "True when driven by the call simulator, not a carrier.",
      "title": "Simulated",
      "type": "boolean"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/CallState",
      "default": "CREATED"
    },
    "transcript": {
      "items": {
        "$ref": "#/$defs/TranscriptTurn"
      },
      "title": "Transcript",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "owner_id",
    "recipient",
    "approval_id"
  ],
  "title": "CallSession",
  "type": "object"
}
