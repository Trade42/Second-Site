{
  "$defs": {
    "CallPurposes": {
      "additionalProperties": false,
      "description": "What the owner approves a voice call to do besides its questions (Rust service only).",
      "properties": {
        "negotiation": {
          "anyOf": [
            {
              "$ref": "#/$defs/NegotiationLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tour": {
          "anyOf": [
            {
              "$ref": "#/$defs/TourRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CallPurposes",
      "type": "object"
    },
    "Channel": {
      "enum": [
        "PHOTON_IMESSAGE",
        "PHOTON_SMS",
        "EMAIL",
        "VOICE",
        "WEB"
      ],
      "title": "Channel",
      "type": "string"
    },
    "NegotiationLimits": {
      "additionalProperties": false,
      "description": "The owner's rent limits for one call. Kept on the server; never returned or logged.",
      "properties": {
        "max_counters": {
          "default": 3,
          "title": "Max Counters",
          "type": "integer"
        },
        "max_monthly_rent_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Monthly Rent Cents"
        },
        "may_mention": {
          "items": {
            "type": "string"
          },
          "title": "May Mention",
          "type": "array"
        },
        "target_monthly_rent_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Monthly Rent Cents"
        }
      },
      "title": "NegotiationLimits",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "A window of local time with the property's UTC offset, e.g. 2026-11-17T15:00:00-08:00.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "TourRequest": {
      "additionalProperties": false,
      "properties": {
        "attendee_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendee Name"
        },
        "duration_minutes": {
          "default": 30,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/TimeWindow"
          },
          "title": "Windows",
          "type": "array"
        }
      },
      "title": "TourRequest",
      "type": "object"
    }
  },
  "$id": "https://second-site.dev/contracts/1.0/OutreachRequest.json",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "intro_recording_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intro Recording Reference"
    },
    "property_id": {
      "format": "uuid",
      "title": "Property Id",
      "type": "string"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "purposes": {
      "anyOf": [
        {
          "$ref": "#/$defs/CallPurposes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "title": "Questions",
      "type": "array"
    },
    "recipient": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Recipient",
      "type": "object"
    }
  },
  "required": [
    "property_id",
    "channel",
    "recipient",
    "purpose"
  ],
  "title": "OutreachRequest",
  "type": "object"
}
