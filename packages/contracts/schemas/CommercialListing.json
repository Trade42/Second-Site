{
  "$defs": {
    "DataOrigin": {
      "description": "Where a record's content came from. Fixtures must never masquerade as live data.",
      "enum": [
        "LIVE",
        "FIXTURE_REAL",
        "FIXTURE_SYNTHETIC",
        "USER_PROVIDED",
        "DERIVED"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "ListingType": {
      "enum": [
        "LEASE",
        "SALE"
      ],
      "title": "ListingType",
      "type": "string"
    }
  },
  "$id": "https://second-site.dev/contracts/1.0/CommercialListing.json",
  "additionalProperties": false,
  "properties": {
    "asking_rent_monthly": {
      "anyOf": [
        {
          "description": "Non-negative integer minor currency units.",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asking Rent Monthly"
    },
    "available_area_sqm": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available Area Sqm"
    },
    "available_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available From"
    },
    "broker_contact": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "{'name','company','phone'} of the listing contact. CoStar kit phones are anonymized (555).",
      "title": "Broker Contact"
    },
    "brokerage_company": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brokerage Company"
    },
    "building_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Building Name"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "data_origin": {
      "$ref": "#/$defs/DataOrigin"
    },
    "disclaimer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disclaimer"
    },
    "existing_buildout": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "'open_shell' | 'office_buildout' | 'second_generation_salon' | null (unknown)",
      "title": "Existing Buildout"
    },
    "lease_service_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Which operating expenses the rent includes, e.g. 'TripleNet', 'FullService', 'ModifiedGross'.",
      "title": "Lease Service Type"
    },
    "lease_term_months": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Term Months"
    },
    "listing_type": {
      "$ref": "#/$defs/ListingType",
      "default": "LEASE"
    },
    "listing_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Listing Url"
    },
    "nnn_charges_monthly": {
      "anyOf": [
        {
          "description": "Non-negative integer minor currency units.",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nnn Charges Monthly"
    },
    "nnn_is_estimate": {
      "default": false,
      "description": "True when nnn_charges_monthly is a DERIVED estimate because the listing quoted none.",
      "title": "Nnn Is Estimate",
      "type": "boolean"
    },
    "photo_urls": {
      "description": "Provider CDN photo links (not stored).",
      "items": {
        "type": "string"
      },
      "title": "Photo Urls",
      "type": "array"
    },
    "property_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property Type"
    },
    "provider": {
      "description": "'costar' only when sourced from CoStar; fixtures say 'fixture'.",
      "title": "Provider",
      "type": "string"
    },
    "provider_listing_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Listing Id"
    },
    "security_deposit": {
      "anyOf": [
        {
          "description": "Non-negative integer minor currency units.",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Security Deposit"
    },
    "source_record_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the provider last certified the record (snapshot freshness).",
      "title": "Source Record Date"
    }
  },
  "required": [
    "provider",
    "data_origin"
  ],
  "title": "CommercialListing",
  "type": "object"
}
