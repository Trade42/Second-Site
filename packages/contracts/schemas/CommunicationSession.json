{
  "$defs": {
    "Channel": {
      "enum": [
        "PHOTON_IMESSAGE",
        "PHOTON_SMS",
        "EMAIL",
        "VOICE",
        "WEB"
      ],
      "title": "Channel",
      "type": "string"
    },
    "CommunicationState": {
      "enum": [
        "DRAFT",
        "AWAITING_APPROVAL",
        "APPROVED",
        "IN_PROGRESS",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "CommunicationState",
      "type": "string"
    },
    "StructuredFinding": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "claim_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'electrical_service_amps'",
          "title": "Claim Type"
        },
        "classification": {
          "default": "OWNER_REPORTED",
          "title": "Classification",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "transcript_offset_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Offset S"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "question"
      ],
      "title": "StructuredFinding",
      "type": "object"
    }
  },
  "$id": "https://second-site.dev/contracts/1.0/CommunicationSession.json",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "authorized_owner_id": {
      "format": "uuid",
      "title": "Authorized Owner Id",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "communication_id": {
      "format": "uuid",
      "title": "Communication Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "external_participants": {
      "description": "[{'role':'broker','name':'...','handle':'+1...'}]",
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "External Participants",
      "type": "array"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "property_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property Id"
    },
    "provider_message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Provider Message Ids",
      "type": "array"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "recording_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recording Reference"
    },
    "state": {
      "$ref": "#/$defs/CommunicationState",
      "default": "DRAFT"
    },
    "structured_findings": {
      "items": {
        "$ref": "#/$defs/StructuredFinding"
      },
      "title": "Structured Findings",
      "type": "array"
    },
    "transcript_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Reference"
    }
  },
  "required": [
    "project_id",
    "channel",
    "authorized_owner_id",
    "purpose"
  ],
  "title": "CommunicationSession",
  "type": "object"
}
