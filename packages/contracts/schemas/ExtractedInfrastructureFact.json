{
  "$defs": {
    "EvidenceClassification": {
      "description": "How an assertion is known. Never collapsed into a single confidence score.",
      "enum": [
        "DOCUMENTED_HISTORICAL",
        "VISUALLY_OBSERVED",
        "GEOMETRY_MEASURED",
        "OWNER_REPORTED",
        "PROFESSIONALLY_VERIFIED",
        "DERIVED_ESTIMATE",
        "UNKNOWN",
        "CONFLICTING"
      ],
      "title": "EvidenceClassification",
      "type": "string"
    }
  },
  "$id": "https://second-site.dev/contracts/1.0/ExtractedInfrastructureFact.json",
  "additionalProperties": false,
  "description": "A technical value parsed from a permit description. Permit status != verification.",
  "properties": {
    "classification": {
      "$ref": "#/$defs/EvidenceClassification",
      "default": "DOCUMENTED_HISTORICAL"
    },
    "fact_type": {
      "description": "e.g. 'electrical_service_amps', 'water_service_diameter'",
      "title": "Fact Type",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "source_text": {
      "description": "Exact substring the value was extracted from.",
      "title": "Source Text",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "fact_type",
    "value",
    "source_text"
  ],
  "title": "ExtractedInfrastructureFact",
  "type": "object"
}
