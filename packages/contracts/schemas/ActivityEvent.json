{
  "$defs": {
    "ActorType": {
      "enum": [
        "agent",
        "user",
        "system",
        "provider"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "project.profile.confirmed",
        "property.search.completed",
        "property.identity.resolved",
        "property.permits.ingested",
        "property.spatial_analysis.completed",
        "property.analysis.completed",
        "infrastructure.unknown_detected",
        "infrastructure.evidence_updated",
        "financial.scenario.updated",
        "property.ranking.updated",
        "outreach.approval_requested",
        "outreach.approved",
        "outreach.completed",
        "call.started",
        "call.owner_handoff_requested",
        "call.owner_joined",
        "call.completed",
        "call.failed",
        "call.finding_recorded",
        "communication.message_received",
        "communication.owner_notified",
        "layout.version_created",
        "layout.validation_failed",
        "layout.approved",
        "bom.generated",
        "bom.recalculation_required",
        "bom.approved",
        "procurement.offer_updated",
        "logistics.timeline_updated",
        "approval.requested",
        "approval.decided",
        "task.started",
        "task.completed",
        "task.failed"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "$id": "https://second-site.dev/contracts/1.0/ActivityEvent.json",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "title": "Actor Id",
      "type": "string"
    },
    "actor_type": {
      "$ref": "#/$defs/ActorType"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "project_id",
    "correlation_id",
    "idempotency_key",
    "actor_type",
    "actor_id",
    "payload"
  ],
  "title": "ActivityEvent",
  "type": "object"
}
