{
  "$defs": {
    "DesignApprovalStatus": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "APPROVED",
        "SUPERSEDED",
        "REJECTED"
      ],
      "title": "DesignApprovalStatus",
      "type": "string"
    },
    "FinishSpecification": {
      "additionalProperties": false,
      "properties": {
        "area_sqm": {
          "exclusiveMinimum": 0,
          "title": "Area Sqm",
          "type": "number"
        },
        "material": {
          "title": "Material",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "surface": {
          "description": "'floor' | 'wall' | 'ceiling'",
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "surface",
        "material",
        "area_sqm"
      ],
      "title": "FinishSpecification",
      "type": "object"
    },
    "FloorEstimate": {
      "additionalProperties": false,
      "description": "What a layout on a floor assumed from the listing's stated area is (DesignVersion.floor_estimate).\n\nNever present on a layout solved on a measured, CAD, owner-measured, photo or fixture floor.",
      "properties": {
        "area_measured": {
          "description": "Always false: the area is the listing's stated figure, not a measurement.",
          "title": "Area Measured",
          "type": "boolean"
        },
        "assumed_shape": {
          "description": "e.g. 'rectangle 3:2, one entrance mid short side'.",
          "title": "Assumed Shape",
          "type": "string"
        },
        "geometry_source": {
          "$ref": "#/$defs/GeometrySource",
          "description": "Always LISTED_AREA_ESTIMATE."
        },
        "label": {
          "description": "A short label for display.",
          "title": "Label",
          "type": "string"
        },
        "listed_area": {
          "description": "The listing's stated area, as stored.",
          "exclusiveMinimum": 0,
          "title": "Listed Area",
          "type": "number"
        },
        "listed_area_unit": {
          "description": "Unit of listed_area as stored ('sqm': CommercialListing.available_area_sqm).",
          "title": "Listed Area Unit",
          "type": "string"
        },
        "shape_assumed": {
          "description": "Always true: the floor's shape is an assumption.",
          "title": "Shape Assumed",
          "type": "boolean"
        },
        "shows": {
          "description": "What the sketch can and cannot show, in plain words.",
          "title": "Shows",
          "type": "string"
        },
        "unknown": {
          "description": "What is not known about the real floor, e.g. 'columns', 'fixed_walls', 'plumbing'.",
          "items": {
            "type": "string"
          },
          "title": "Unknown",
          "type": "array"
        }
      },
      "required": [
        "geometry_source",
        "shape_assumed",
        "area_measured",
        "listed_area",
        "listed_area_unit",
        "assumed_shape",
        "unknown",
        "shows",
        "label"
      ],
      "title": "FloorEstimate",
      "type": "object"
    },
    "FurniturePlacement": {
      "additionalProperties": false,
      "properties": {
        "footprint": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Footprint",
          "type": "array"
        },
        "item_type": {
          "title": "Item Type",
          "type": "string"
        },
        "placement_id": {
          "title": "Placement Id",
          "type": "string"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        }
      },
      "required": [
        "placement_id",
        "room_id",
        "item_type",
        "footprint"
      ],
      "title": "FurniturePlacement",
      "type": "object"
    },
    "GeometrySource": {
      "enum": [
        "MATTERPORT_MEASURED",
        "CAD_OR_IFC",
        "OWNER_MEASURED",
        "PHOTO_ESTIMATE",
        "FIXTURE",
        "LISTED_AREA_ESTIMATE"
      ],
      "title": "GeometrySource",
      "type": "string"
    },
    "GeometryValidationReport": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "disclaimer": {
          "default": "Automated geometric check only. Not a code-compliance review or professionally approved plan.",
          "title": "Disclaimer",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "title": "GeometryValidationReport",
      "type": "object"
    },
    "RoomPolygon": {
      "additionalProperties": false,
      "properties": {
        "area_sqm": {
          "exclusiveMinimum": 0,
          "title": "Area Sqm",
          "type": "number"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Polygon",
          "type": "array"
        },
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "room_type": {
          "title": "Room Type",
          "type": "string"
        }
      },
      "required": [
        "room_id",
        "room_type",
        "polygon",
        "area_sqm"
      ],
      "title": "RoomPolygon",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "room_ids": {
          "items": {
            "type": "string"
          },
          "title": "Room Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$id": "https://second-site.dev/contracts/1.0/DesignVersion.json",
  "additionalProperties": false,
  "properties": {
    "approval_status": {
      "$ref": "#/$defs/DesignApprovalStatus",
      "default": "DRAFT"
    },
    "created_from_revision_request": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created From Revision Request"
    },
    "design_version_id": {
      "format": "uuid",
      "title": "Design Version Id",
      "type": "string"
    },
    "estimated_construction_cost": {
      "anyOf": [
        {
          "description": "Non-negative integer minor currency units.",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Construction Cost"
    },
    "finish_specifications": {
      "items": {
        "$ref": "#/$defs/FinishSpecification"
      },
      "title": "Finish Specifications",
      "type": "array"
    },
    "floor_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/FloorEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set only when the layout was solved on a floor assumed from the listing's stated area (LISTED_AREA_ESTIMATE): what is assumed and unknown."
    },
    "furniture_placements": {
      "items": {
        "$ref": "#/$defs/FurniturePlacement"
      },
      "title": "Furniture Placements",
      "type": "array"
    },
    "geometry_id": {
      "format": "uuid",
      "title": "Geometry Id",
      "type": "string"
    },
    "parent_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Version Id"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "property_id": {
      "format": "uuid",
      "title": "Property Id",
      "type": "string"
    },
    "proposed_walls": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          }
        ],
        "type": "array"
      },
      "title": "Proposed Walls",
      "type": "array"
    },
    "room_polygons": {
      "items": {
        "$ref": "#/$defs/RoomPolygon"
      },
      "title": "Room Polygons",
      "type": "array"
    },
    "validation_report": {
      "$ref": "#/$defs/GeometryValidationReport"
    },
    "version_number": {
      "minimum": 1,
      "title": "Version Number",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "property_id",
    "version_number",
    "geometry_id",
    "room_polygons",
    "validation_report"
  ],
  "title": "DesignVersion",
  "type": "object"
}
