   "name": ".env.example",
   "text": "# Second Site environment. Copy to .env (gitignored). NEVER commit real secrets.\n# Every provider defaults to fixture mode: no real calls, messages, or purchases happen.\n\n# ---- APPLICATION ----\nAPP_ENV=development\nLOG_LEVEL=INFO\nCORS_ORIGINS=http://localhost:3000\nPUBLIC_BASE_URL=http://localhost:8000        # public HTTPS in prod: Telnyx/Photon webhooks + intro audio links\nPUBLIC_WEB_URL=http://localhost:3000         # links in owner texts (approvals, handoffs)\nTASK_EXECUTION_MODE=inline          # inline | redis (redis requires the worker)\n\n# ---- DATABASE ----\nDATABASE_URL=postgresql+psycopg://secondsite:secondsite@localhost:5432/secondsite\nTEST_DATABASE_URL=postgresql+psycopg://secondsite:secondsite@localhost:5432/secondsite_test\n\n# ---- REDIS ----\nREDIS_URL=redis://localhost:6379/0\n\n# ---- AUTHENTICATION ----\nAUTH_SECRET=change-me-in-any-shared-deployment\nALLOW_DEV_TOKENS=true                # must be false in production\n\n# ---- MODEL PROVIDER (LangChain init_chat_model string). Empty = deterministic supervisor. ----\nSUPERVISOR_MODEL=\n# SUPERVISOR_MODEL=anthropic:claude-sonnet-5-5\n# SUPERVISOR_MODEL=codex:gpt-6.1-terra:low   # owner's ChatGPT plan via the signed-in Codex CLI (codex:<model>[:<effort>]); sends project facts to OpenAI\nANTHROPIC_API_KEY=\nAGENT_CHECKPOINTER=memory            # memory | postgres\n# Rust API origin for the supervisor tools (e.g. http://localhost:8000, no /api/v1). Empty = tools run in-process.\nBACKEND_API_URL=\n\n# ---- PROVIDER MODES (live | fixture | disabled) ----\nPROPERTY_PROVIDER_MODE=fixture\nPERMIT_PROVIDER_MODE=fixture         # live works without credentials (public Socrata API)\nVOICE_PROVIDER_MODE=fixture\nMESSAGING_PROVIDER_MODE=fixture\nPROCUREMENT_PROVIDER_MODE=fixture\n\n# ---- COSTAR: password-protected data kit (JSONL), not an API. PROPERTY_PROVIDER_MODE=live reads it. ----\n# Extract the kit (zip password from the team, never committed) to .data/costar-kit (gitignored).\nCOSTAR_KIT_DIR=                      # default: <repo>/.data/costar-kit\n\n# ---- MATTERPORT Model API (GraphQL). Token id = API key, token secret = API token. ----\nMATTERPORT_PROVIDER_MODE=fixture     # live: suite scans + measured floor geometry\nMATTERPORT_API_KEY=\nMATTERPORT_API_TOKEN=\nMATTERPORT_SDK_KEY=                  # Showcase SDK (browser embed); not used server-side yet\n\n# ---- VEXCEL API 2.0 (X-API-KEY) ----\nVEXCEL_PROVIDER_MODE=fixture         # live: orthomosaic imagery + roof/structure elements\nVEXCEL_API_KEY=\n\n# ---- LA OPEN DATA (Socrata) ----\nLA_OPEN_DATA_BASE_URL=https://data.lacity.org\nLA_OPEN_DATA_APP_TOKEN=              # optional; raises rate limits\nLA_ELECTRICAL_DATASET=ysqd-apz7\nLA_MECHANICAL_DATASET=67is-svtd\n\n# ---- PHOTON 2.0 (beta) ----\nPHOTON_API_KEY=\nPHOTON_PROJECT_ID=\nPHOTON_WEBHOOK_SECRET=               # whsec_... from the webhook destination\nPHOTON_AGENT_HANDLE=                 # the agent's assigned number, shown to the owner (\"text hi to ...\")\n\n# ---- TELNYX ----\nTELNYX_API_KEY=\nTELNYX_PUBLIC_KEY=                   # base64 Ed25519 public key (Mission Control > Keys)\nTELNYX_CONNECTION_ID=\nTELNYX_FROM_NUMBER=\n\n# ---- XAI VOICE ----\nXAI_API_KEY=\n# Live voice stays off unless all three switches are set (VOICE_BRIDGE_ENABLED=true, VOICE_PROVIDER_MODE=live, XAI_API_KEY); no call is placed without the owner's approval in the app.\nVOICE_BRIDGE_ENABLED=false\n# The Grok Voice realtime endpoint; used only when live voice is on (all three switches set), and no call is placed without the owner's approval in the app.\nXAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-latest\n# The assistant's voice; used only when live voice is on (all three switches set), and no call is placed without the owner's approval in the app.\nXAI_VOICE=eve\n# Seconds allowed after the recorded introduction's own length before the call ends politely; used only when live voice is on (all three switches set), and no call is placed without the owner's approval in the app.\nVOICE_INTRO_GRACE_S=15\n\n# ---- OBJECT STORAGE ----\nOBJECT_STORAGE_MODE=local\nOBJECT_STORAGE_LOCAL_DIR=./.data/objects\n\n# ---- SAFETY SWITCHES (off by default) ----\nALLOW_LIVE_OUTBOUND_CALLS=false\nALLOW_LIVE_PURCHASES=false\n# Rust service only; turn it on before opening a tunnel. On: a request with a non-loopback Host or a forwarding\n# header reaches only the Telnyx webhook, the call audio stream, the signed media link and /record; the rest is 404.\nPUBLIC_PATH_GUARD=false\n\n# ---- RUST SERVICE (apps/backend) ----\n# It reads every name above except TEST_DATABASE_URL and BACKEND_API_URL, with the Python app's\n# defaults, plus these. The commented lines show the defaults; uncomment one to change it (an\n# empty HOST= or PORT= is an error, not the default). apps/backend/scripts/run-local.sh sets\n# STORE_BACKEND, HOST, PORT and FIXTURES_DIR itself: with it, set those four in the environment\n# (a line here does not change them).\n# STORE_BACKEND=postgres\n#   postgres | memory. memory is a demo store without a database: nothing is durable.\n# HOST=0.0.0.0\n#   apps/backend/scripts/run-local.sh binds 127.0.0.1 unless HOST is set in the environment.\n# PORT=8000\n# FIXTURES_DIR=\n#   Fixture files read at run time; default: the repository's fixtures/ (image: /app/fixtures).\n# APP_VERSION=0.1.0\n# MATTERPORT_GRAPH_URL=https://api.matterport.com/api/models/graph\n# VEXCEL_BASE_URL=https://api.vexcelgroup.com/v2\n# Python app origin (no /api/v1). The Rust service forwards the Photon routes, the project chat\n# and the Studio routes to it, and texts the owner through it. Unset or blank: those routes\n# answer 503 PYTHON_SERVICE_NOT_CONFIGURED and owner texts are recorded as not sent.\n# Example, Python on 8001:\n# PYTHON_SERVICE_URL=http://localhost:8001\n\n# ---- CAPITAL ONE NESSIE (sandbox only: mock money, never a real bank account) ----\n# Read by the Rust service's Nessie routes, from the environment or this .env like every other\n# name (docker compose passes it in through env_file). Mode: empty, fixture or\n# disabled = the labelled in-memory fixture bank; live with a key = the Capital One Nessie\n# sandbox (live without a key: the fixture bank, and /ready says BLOCKED); any other value: every\n# Nessie route answers 503. The key goes in the Authorization header only. Empty base URL =\n# https://v2-prod-api.nessieisreal.com.\nNESSIE_PROVIDER_MODE=\nNESSIE_API_KEY=\nNESSIE_BASE_URL=\n\n# ---- DEPLOYMENT / OBSERVABILITY ----\n# See infra/oracle/README.md. Logs are JSON on stdout.\n",
