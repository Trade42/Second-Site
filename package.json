{
  "name": "second-site",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "contracts:generate": "pnpm --filter @second-site/contracts generate",
    "web:dev": "pnpm --filter @second-site/web dev",
